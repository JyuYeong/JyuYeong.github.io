  "description": "라벨·주제·작업 이력·오늘 할 일로 Task를 관리하는 개인용 앱",
  "id": "/task-manager-v2/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
